            },
            "unit": {
              ".validate": "newData.isString() && (newData.val() == 'pieces' || newData.val() == 'minutes' || newData.val() == 'kg') && (!data.parent().exists() || newData.val() == data.val())"
            },
            "fromDate": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10 && (!data.parent().exists() || newData.val() == data.val())"
            },
            "toDate": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10 && (!data.parent().exists() || newData.val() == data.val())"
            },
            "context": {
              ".validate": "newData.hasChildren([\"machineId\",\"processId\",\"productId\"]) && (data.exists() || (root.child('workspaces').child($ws).child('machines').child(newData.child('machineId').val()).child('active').val() == true && root.child('workspaces').child($ws).child('processes').child(newData.child('processId').val()).child('active').val() == true && root.child('workspaces').child($ws).child('products').child(newData.child('productId').val()).child('active').val() == true && root.child('workspaces').child($ws).child('processes').child(newData.child('processId').val()).child('machineId').val() == newData.child('machineId').val() && root.child('workspaces').child($ws).child('products').child(newData.child('productId').val()).child('processIds').child(newData.child('processId').val()).val() == true))",
              "machineId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && (!data.parent().exists() || newData.val() == data.val())"
              },
