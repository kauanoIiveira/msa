              ".validate": "newData.hasChildren([\"kind\"]) && ((newData.child('kind').val() == 'pending' && !newData.hasChild('lower') && !newData.hasChild('upper')) || (newData.child('kind').val() == 'range' && newData.hasChildren(['lower','upper']) && newData.child('lower').val() < newData.child('upper').val()) || (newData.child('kind').val() == 'lower' && newData.hasChild('lower') && !newData.hasChild('upper')) || (newData.child('kind').val() == 'upper' && newData.hasChild('upper') && !newData.hasChild('lower')))",
              "kind": {
                ".validate": "newData.isString() && (newData.val() == 'range' || newData.val() == 'lower' || newData.val() == 'upper' || newData.val() == 'pending') && (!data.parent().exists() || newData.val() == data.val())"
